#
# The kind tier's values for the gateway image's data-plane template
# (image/gateway/envoy/gateway.yaml.in): `make kind-gateway-envoy` renders envoy.yaml from
# them and `make gateway-render-check` fails when the committed file drifts from the
# template, so the bootstrap the tier proves is the one the image renders. Every interface
# (the pod has one), the tier's trust domain, the CSI driver's socket path, the authorizer
# in the same pod.
SANDBOX_ADDRESS=0.0.0.0
DATA_PORT=8443
TRUST_DOMAIN=sandbox.test
SPIRE_SOCKET=/run/spire/sockets/spire-agent.sock
# Loopback TCP, on purpose, and only here: a gateway VM asks the authorizer's check socket by
# default (image/gateway/env.example, ADR-0053 open question 7), but the tier's gateway is a
# pod whose two containers share a network namespace and no socket directory, and the
# authorizer container is started with `--listen 127.0.0.1:9001` (gateway.yaml). Nothing in a
# pod is another local user's to keep out, and the host table, whose loopback exception this
# would need on a VM, does not exist in the tier.
AUTHORIZER_ENDPOINT=socket_address: { address: 127.0.0.1, port_value: 9001 }
TUNNEL_MAX_SECS=86400
