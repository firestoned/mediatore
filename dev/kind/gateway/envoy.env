#
# The kind tier's values for the gateway image's data-plane template
# (image/gateway/envoy/gateway.yaml.in): `make kind-gateway-envoy` renders envoy.yaml from
# them and `make gateway-render-check` fails when the committed file drifts from the
# template, so the bootstrap the tier proves is the one the image renders. Every interface
# (the pod has one), the tier's trust domain, the CSI driver's socket path, the authorizer
# in the same pod.
SANDBOX_ADDRESS=0.0.0.0
DATA_PORT=8443
TRUST_DOMAIN=sandbox.test
SPIRE_SOCKET=/run/spire/sockets/spire-agent.sock
AUTHORIZER_ADDRESS=127.0.0.1
AUTHORIZER_PORT=9001
