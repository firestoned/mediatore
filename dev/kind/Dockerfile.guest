# Test-only image for the kind tier (`make kind-e2e-mtls`): the two guest binaries,
# which production bakes into VM images, run here as pods with the SPIFFE CSI volume so
# a real agent issues their SVIDs. Built from `dist/` (`make dist`); never published.
FROM cgr.dev/chainguard/static:latest
COPY dist/mediatore-guest dist/sandbox-token /usr/local/bin/
USER 65532:65532
