[Unit]
Description=mediatore gateway, the authorizer Envoy asks on every tunnel (ADR-0028 decision 4)
Requires=spire-agent.service mediatore-gateway-nft.service
After=spire-agent.service mediatore-gateway-nft.service network-online.target
Wants=network-online.target
ConditionPathExists=|/run/cos/active_mode
ConditionPathExists=|/run/cos/passive_mode

[Service]
User=mediatore-gateway
Group=mediatore-gateway
ExecStartPre=/usr/bin/spire-agent healthcheck -socketPath /run/spire/sockets/agent.sock
# On loopback, where only Envoy reaches it; the broker's address and the agent's socket
# from the env file (MEDIATORE_URL, SPIFFE_ENDPOINT_SOCKET), the cache bounds the role's
# defaults (fresh 30 s, stale 300 s, 4096 claims).
ExecStart=/usr/bin/mediatore gateway --listen 127.0.0.1:9001
EnvironmentFile=/etc/mediatore-gateway/env
EnvironmentFile=-/etc/mediatore-gateway/vm.env
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/run/spire/sockets

[Install]
WantedBy=multi-user.target
