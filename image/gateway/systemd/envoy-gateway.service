[Unit]
Description=Envoy, the egress gateway's data plane (ADR-0028)
# No table, no listener; no interface, no listener; the SVID comes from the agent over SDS;
# the authorizer is asked on every tunnel, so it is started first (Envoy retries the
# cluster meanwhile and refuses every CONNECT until it answers).
# It is asked on its CHECK socket by default, which this unit's group (envoy) reaches and no
# other user does (ADR-0040 decision 6); a connect needs no write access to the mount below.
Requires=mediatore-gateway-nft.service mediatore-gateway-network.service spire-agent.service
After=mediatore-gateway-nft.service mediatore-gateway-network.service spire-agent.service network-online.target mediatore-gateway.service
Wants=network-online.target mediatore-gateway.service
# Names are resolved by systemd-resolved's stub alone (image/gateway/resolve/resolv.conf): the
# stub is started first, and this unit sees a resolv.conf that names it and nothing else, checked
# before Envoy starts (a base whose /etc/resolv.conf does not point into /run/systemd/resolve
# fails here, visibly, rather than resolving through whatever that file lists).
Wants=systemd-resolved.service
After=systemd-resolved.service
ConditionPathExists=|/run/cos/active_mode
ConditionPathExists=|/run/cos/passive_mode

[Service]
User=envoy
Group=envoy
# The bootstrap is rendered by root from the env files at every start, into the runtime
# directory the table's unit created; the templates are the image's, the values the
# deployment's and the VM's (ADR-0028 decision 10).
ExecStartPre=+/usr/libexec/mediatore-gateway/render /usr/share/mediatore-gateway/envoy/gateway.yaml.in /run/mediatore-gateway/gateway.yaml /etc/mediatore-gateway/env /etc/mediatore-gateway/vm.env
ExecStartPre=/bin/sh -c 'grep -qx "nameserver 127.0.0.53" /etc/resolv.conf && test "$$(grep -c "^nameserver" /etc/resolv.conf)" = 1 || { echo "/etc/resolv.conf does not name the resolved stub alone: Envoy would not resolve through the egress link (image/gateway/resolve)" >&2; exit 1; }'
ExecStartPre=/usr/bin/envoy --mode validate -c /run/mediatore-gateway/gateway.yaml
ExecStart=/usr/bin/envoy -c /run/mediatore-gateway/gateway.yaml --log-level info --disable-hot-restart
Restart=on-failure
RestartSec=2
# ADR-0028 decision 8: no new privileges, no capability (the listener's port is
# unprivileged), a private /tmp, a read-only root. Only the agent's socket and the runtime
# directory are reached; the logs go to the journal.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# "-" on the agent's socket directory, as on the authorizer's unit and for its reason: this unit
# only Wants= the authorizer, so it is started after an authorizer whose start failed, and the
# directory may not exist yet, and a missing one is then simply not made read-only.
# ProtectSystem=strict does not by itself keep /run read-only here: on systemd 257 /run stays
# writable once a unit also sets ProtectKernelTunables= (seen on the build host, 2026-11-27),
# and this unit sets it. The line below names the runtime directory read-only; elsewhere in
# /run file ownership and modes bound this user. (The inject Envoy Requires= the authorizer, whose health check
# has by then answered on that socket.)
ReadOnlyPaths=/run/mediatore-gateway -/run/spire/sockets
# The resolver: /run/systemd/resolve, where /etc/resolv.conf points on Kairos, is the image's
# directory here, whose resolv.conf names the stub on 127.0.0.53 alone. The directory, not the
# file: resolved replaces its files by rename, and a rename detaches a bind of the file itself in
# every other mount namespace, which would hand Envoy the link's servers (or the fallback ones)
# again at its resolver's next reinitialisation.
BindReadOnlyPaths=/usr/share/mediatore-gateway/resolve:/run/systemd/resolve

[Install]
WantedBy=multi-user.target
