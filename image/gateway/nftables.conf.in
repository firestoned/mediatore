#!/usr/sbin/nft -f
# Copyright (c) 2026 Erick Bourgeois, mediatore
# SPDX-License-Identifier: Apache-2.0
#
# The gateway host's table (ADR-0027 decision 5, ADR-0028 decision 8), rendered from the
# env file by mediatore-gateway-nft.service before either Envoy may start. Input is
# default drop. On the sandbox interface only the data plane and the four relay ports are
# admitted, a new connection to a relay port counted per source and dropped over the cap
# (the control plane has no identity to rate-limit by). On the egress interface nothing
# new arrives: replies to the gateway's own connections only. Forwarding is off in sysctl
# and dropped here as well. Nothing listens on loopback: the authorizer is asked on a unix socket (on loopback TCP only where a deployment set that on purpose). The inject Envoy's port (ADR-0040 decision 7) is a fifth
# element of the relay's set, under the same per-source cap, only when the deployment sets INJECT_PORT_ELEMENT (env.inject.example).
#
# Output (ADR-0053 decisions 5 and 6) is keyed on the socket's owner. The policy stays accept
# for the users the table does not name (root, the resolver's, the clock's); the five it names
# may open a new connection only where their row says, and three rules hold for every user:
# nothing new leaves by the sandbox interface, the broker's address is reached by the
# authorizer's and the relay's users and by nobody else, and the cloud platform's addresses
# (ADR-0068) are kept to the one user that needs each: the instance metadata service
# (169.254.169.254) to nobody, root included, and Azure's WireServer (168.63.129.16) to root at
# TCP 80 and 32526 and to systemd-networkd's user for the DHCP renewal, its port 53 (the
# resolver Azure hands out) left to each user's row as any resolver is. These lines only narrow
# what the policy already admitted, so they are the same on every platform: off Azure neither
# address answers. User names are resolved when the
# table loads: one that does not exist fails the load, and with it every unit that requires
# the table. Unix sockets are not seen here: the agent's stays reachable to both Envoys.
#   mediatore-gateway  the broker, BROKER_ADDRESS at BROKER_PORT, and nothing else
#   envoy-relay        its four fixed upstreams, each by address and port, and nothing else
#   spire              the SPIRE server, and nothing else
#   envoy              any IPv4 destination that is not loopback or one of the VM's own
#                      addresses, link-local, a control-plane address of the env file or one
#                      of the operator's EGRESS_DENY_ELEMENTS; no IPv6. No loopback exception
#                      by default (its check is a unix socket); one port, the authorizer's,
#                      only where a deployment keeps the check on loopback TCP on purpose
#                      (CHECK_TCP_ELEMENTS)
#   envoy-inject       the same, with no loopback exception ever (its check is a unix socket)
# A name a claim is allowed is resolved by Envoy; the rules above apply at connect time, to
# whatever address it resolved to. The three keys this chain added are optional, each with
# its default written at its placeholder below, so an env file from before the chain existed
# still loads the table (image/gateway/render).
#
# What the table drops and no honest machine sends is counted by name (ADR-0070 decision 4), for
# mediatore-gateway-probes.service to read and zero ("nft reset") and hand to the authorizer:
#   gateway_port       a new TCP connection from the sandbox interface to a port the gateway does
#                      not serve, with its source address and port kept in probe_sources
#   gateway_output_*   one counter per dropping rule of the output chains
# A counter is a statement on a rule that drops, never a rule of its own and never on one that
# accepts; the one rule this added is a drop placed in front of the input chain's last drop,
# which would have dropped the same packet. "flush ruleset" below means every load starts the
# counters and the set again from nothing.
flush ruleset
table inet mediatore_gateway {
  # Where neither Envoy may open a connection, whatever name led there: link-local, the
  # control plane's addresses, and the ranges the operator lists (", 10.0.0.0/8, ..." in
  # EGRESS_DENY_ELEMENTS; empty by default, those ranges are then the datacenter firewall's).
  set egress_refused { type ipv4_addr; flags interval; auto-merge; elements = { 169.254.0.0/16, @SPIRE_SERVER_ADDRESS@, @SPIRE_BUNDLE_ADDRESS@, @BROKER_ADDRESS@@EGRESS_DENY_ELEMENTS:-@ } }
  # The authorizer's tunnel check, only for a deployment that keeps it on loopback TCP on
  # purpose: "elements = { 9001 }". Empty by default, the key absent included: the data plane
  # asks the check socket, and the rule in output_envoy below then matches nothing.
  set check_tcp { type inet_service; @CHECK_TCP_ELEMENTS:-@ }
  # A further resolver the Envoys may ask, only where the rules below would refuse it: an
  # address inside a denied range. Empty by default. The image's Envoys ask resolved's stub
  # (127.0.0.53, admitted in output_listener whatever this set holds) and nothing else.
  set resolvers { type ipv4_addr; @RESOLVER_ELEMENTS:-@ }
  set relay_ports { type inet_service; elements = { @RELAY_SPIRE_PORT@, @RELAY_BROKER_PORT@, @RELAY_BUNDLE_PORT@@INJECT_PORT_ELEMENT@ } }
  # One element per sandbox source address, counting its connections to the relay.
  set relay_sources { type ipv4_addr; flags dynamic; size 65535; }
  # Who probed which port (gateway_port): one element per source address and destination port,
  # each with its own packet counter, gone five minutes after its last packet. A full set
  # stops naming sources and nothing else: the rule's counter comes first and the chain's last
  # rule still drops.
  set probe_sources { type ipv4_addr . inet_service; size 4096; flags dynamic,timeout; counter; timeout 5m; }
  counter gateway_port { }
  counter gateway_output_sandbox { }
  counter gateway_output_imds { }
  counter gateway_output_wireserver { }
  counter gateway_output_broker { }
  counter gateway_output_authorizer { }
  counter gateway_output_relay { }
  counter gateway_output_agent { }
  counter gateway_output_loopback { }
  counter gateway_output_ipv6 { }
  counter gateway_output_refused { }
  chain input {
    type filter hook input priority filter; policy drop;
    iif "lo" accept
    ct state established,related accept
    ct state invalid drop
    iifname "@SANDBOX_IF@" tcp dport @relay_ports ct state new add @relay_sources { ip saddr ct count over @RELAY_CAP@ } log prefix "mediatore-gateway cap: " counter drop
    iifname "@SANDBOX_IF@" tcp dport @relay_ports ct state new accept
    iifname "@SANDBOX_IF@" tcp dport @DATA_PORT@ ct state new accept
    iifname "@SANDBOX_IF@" meta nfproto ipv4 meta l4proto tcp ct state new counter name "gateway_port" update @probe_sources { ip saddr . tcp dport } log prefix "mediatore-gateway drop: " drop
    log prefix "mediatore-gateway drop: " counter drop
  }
  chain forward {
    type filter hook forward priority filter; policy drop;
    log prefix "mediatore-gateway forward: " counter drop
  }
  chain output {
    type filter hook output priority filter; policy accept;
    # Replies of the listeners and every connection already admitted: the rules below are
    # about a new one.
    ct state established,related accept
    # Every user: nothing on a gateway initiates toward the sandbox segment (ADR-0010).
    oifname "@SANDBOX_IF@" ct state new counter name "gateway_output_sandbox" log prefix "mediatore-gateway out sandbox: " drop
    # Every user, root included: no instance metadata service (ADR-0068); WireServer by its own chain.
    ip daddr 169.254.169.254 counter name "gateway_output_imds" log prefix "mediatore-gateway out imds: " drop
    ip daddr 168.63.129.16 jump output_wireserver
    meta skuid "mediatore-gateway" jump output_authorizer
    meta skuid "envoy-relay" jump output_relay
    meta skuid "spire" jump output_agent
    meta skuid "envoy" jump output_envoy
    meta skuid "envoy-inject" jump output_listener
    # Every other user, root included: as before, but for the broker's address, on any port.
    ip daddr @BROKER_ADDRESS@ ct state new counter name "gateway_output_broker" log prefix "mediatore-gateway out broker: " drop
  }
  chain output_wireserver {
    # Azure's DNS at the same address: back to the user rows, which treat it as any resolver.
    meta l4proto { tcp, udp } th dport 53 return
    # The provisioning ready report and the host plugin: root's alone.
    meta skuid 0 tcp dport { 80, 32526 } accept
    # The lease renewal of systemd-networkd, which runs as its own user.
    meta skuid "systemd-network" udp sport 68 udp dport 67 accept
    counter name "gateway_output_wireserver" log prefix "mediatore-gateway out wireserver: " drop
  }
  chain output_authorizer {
    ip daddr @BROKER_ADDRESS@ tcp dport @BROKER_PORT@ accept
    counter name "gateway_output_authorizer" log prefix "mediatore-gateway out authorizer: " drop
  }
  chain output_relay {
    ip daddr @SPIRE_SERVER_ADDRESS@ tcp dport @SPIRE_SERVER_PORT@ accept
    ip daddr @BROKER_ADDRESS@ tcp dport @BROKER_PORT@ accept
    ip daddr @SPIRE_BUNDLE_ADDRESS@ tcp dport @SPIRE_BUNDLE_PORT@ accept
    counter name "gateway_output_relay" log prefix "mediatore-gateway out relay: " drop
  }
  chain output_agent {
    ip daddr @SPIRE_SERVER_ADDRESS@ tcp dport @SPIRE_SERVER_PORT@ accept
    counter name "gateway_output_agent" log prefix "mediatore-gateway out agent: " drop
  }
  chain output_envoy {
    # The one loopback exception there can be, the tunnel Envoy's alone: the authorizer's
    # check while a deployment keeps it on loopback TCP. The set is empty by default.
    oif "lo" ip daddr 127.0.0.1 tcp dport @check_tcp accept
    jump output_listener
  }
  chain output_listener {
    # systemd-resolved's stub, the one resolver both Envoys' units let them read in resolv.conf
    # (image/gateway/resolve): loopback, port 53 alone. The stub asks the egress link's servers as
    # its own user, which no row here names (2026-11-28: no fallback, no lookup past the link).
    oif "lo" ip daddr 127.0.0.53 meta l4proto { tcp, udp } th dport 53 accept
    ip daddr @resolvers meta l4proto { tcp, udp } th dport 53 accept
    oif "lo" counter name "gateway_output_loopback" log prefix "mediatore-gateway out loopback: " drop
    meta nfproto ipv6 counter name "gateway_output_ipv6" log prefix "mediatore-gateway out ipv6: " drop
    ip daddr @egress_refused counter name "gateway_output_refused" log prefix "mediatore-gateway out refused: " drop
    accept
  }
}
