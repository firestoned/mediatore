#
# The egress gateway's environment: one file per deployment, the same on all three VMs
# (/etc/mediatore-gateway/env, written by the deployment's cloud-config layer). Read by
# image/gateway/render into the two Envoy bootstraps, the host table and the sandbox
# interface, and by systemd into mediatore gateway's environment. Addresses, not names:
# the relay resolves nothing for the sandbox, and the authorizer's broker is reached on
# the egress side. Whole-line comments only; no '|' in a value. Nothing here is a secret.
# The per-VM half (the sandbox address) is vm.env (image/gateway/vm.env.example).
TRUST_DOMAIN=sandbox.home.example
# The second NIC, the one on the sandbox segment (banlieue ADR-0109 decision 4; the
# egress NIC is first in the class and carries the default route).
SANDBOX_IF=enp2s0
SANDBOX_PREFIX=24
# The data plane (ADR-0028 decision 3): what the forwarder in every sandbox dials.
DATA_PORT=8443
# The control relay (ADR-0027 decision 2): the agent's server_address and the pool's
# MEDIATORE_URL point here, at a gateway's sandbox address.
RELAY_SPIRE_PORT=3129
RELAY_BROKER_PORT=3130
# New connections one sandbox address may hold open to the relay at once (ADR-0027
# decision 5); the agent holds one stream, the guest and the proxy one connection each.
RELAY_CAP=16
# The relay's fixed upstreams, by address, on the egress side.
SPIRE_SERVER_ADDRESS=192.0.2.20
SPIRE_SERVER_PORT=8081
BROKER_ADDRESS=192.0.2.21
BROKER_PORT=443
# The authorizer, on loopback, and the agent's socket Envoy's SDS and the authorizer use.
AUTHORIZER_ADDRESS=127.0.0.1
AUTHORIZER_PORT=9001
SPIRE_SOCKET=/run/spire/sockets/agent.sock
# mediatore gateway's own environment (ADR-0028 decision 4): the broker's sandbox
# listener, reached on the egress side with the gateway SVID; the same socket.
MEDIATORE_URL=https://192.0.2.21
SPIFFE_ENDPOINT_SOCKET=unix:///run/spire/sockets/agent.sock
RUST_LOG=info
