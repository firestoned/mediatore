#
# The egress gateway's environment: one file per deployment, the same on all three VMs
# (/etc/mediatore-gateway/env, written by the deployment's cloud-config layer). Read by
# image/gateway/render into the two Envoy bootstraps, the host table and the sandbox
# interface, and by systemd into mediatore gateway's environment. Addresses, not names:
# the relay resolves nothing for the sandbox, and the authorizer's broker is reached on
# the egress side. Whole-line comments only; no '|' in a value. Nothing here is a secret.
# The per-VM half (the sandbox address) is vm.env (image/gateway/vm.env.example).
TRUST_DOMAIN=sandbox.home.example
# The second NIC, the one on the sandbox segment (banlieue ADR-0109 decision 4; the
# egress NIC is first in the class and carries the default route).
SANDBOX_IF=enp2s0
SANDBOX_PREFIX=24
# The data plane (ADR-0028 decision 3): what the forwarder in every sandbox dials.
DATA_PORT=8443
# The control relay (ADR-0027 decision 2): the agent's server_address and the pool's
# MEDIATORE_URL point here, at a gateway's sandbox address.
RELAY_SPIRE_PORT=3129
RELAY_BROKER_PORT=3130
# The bundle leg (ADR-0037): the pool VM's first-boot fetch of the SPIRE trust bundle,
# curl against this port with the bundle endpoint's own hostname, TLS end to end.
RELAY_BUNDLE_PORT=3131
# The registry leg (ADR-0038): the pool VM's pull of a workload image from the operator's registry, root's alone
# (the host table admits it to uid 0 and the jail's table never lists it), TLS end to end with the registry's own name.
RELAY_REGISTRY_PORT=3132
# New connections one sandbox address may hold open to the relay at once (ADR-0027
# decision 5); the agent holds one stream, the guest and the proxy one connection each.
RELAY_CAP=16
# The relay's fixed upstreams, by address, on the egress side.
SPIRE_SERVER_ADDRESS=192.0.2.20
SPIRE_SERVER_PORT=8081
# The SPIRE servers' bundle endpoint (https_web, a web PKI certificate), by address.
SPIRE_BUNDLE_ADDRESS=192.0.2.20
SPIRE_BUNDLE_PORT=8443
# The operator's registry, by address (a repository dedicated to the pool's images, read-only: the leg cannot restrict paths).
REGISTRY_ADDRESS=192.0.2.22
REGISTRY_PORT=443
BROKER_ADDRESS=192.0.2.21
BROKER_PORT=443
# The authorizer's address as the data plane's Envoy dials it, a whole `address:` value (a socket_address on loopback by default; with the
# inject Envoy on, env.inject.example puts a unix socket in front of this, ADR-0040 decision 6), and the agent's socket Envoy's SDS and the
# authorizer use.
AUTHORIZER_ENDPOINT=socket_address: { address: 127.0.0.1, port_value: 9001 }
SPIRE_SOCKET=/run/spire/sockets/agent.sock
# A tunnel is authorized once, when it opens, and no tunnel outlives TUNNEL_MAX_SECS: set it to the longest lifetime a claim may have
# in this environment (a day here). A claim released sooner keeps a tunnel it already holds until then; new ones are refused at once.
TUNNEL_MAX_SECS=86400
# The inject Envoy (ADR-0040 decision 3), a third process: OFF until the deployment enables envoy-inject.service and puts
# env.inject.example in front of this file. It terminates a claim's mutual TLS on INJECT_PORT and originates TLS to one fixed upstream, so
# the credential an audience needs is added at the gateway and never reaches the pool VM. The upstream is a host NAME (its certificate is
# verified by name; the placeholder below is RFC 2606's). INJECT_DOMAIN is the route's domain: the host alone for port 443 (the guest proxy
# sends Host without a port), host:port for any other. INJECT_CA_FILE: the system roots, or a PEM for an upstream on a private PKI. A stream
# that moves nothing for INJECT_STREAM_IDLE_SECS ends and none outlives INJECT_MAX_STREAM_SECS (the longest claim's default lifetime).
# INJECT_AUTHORIZER_SOCKET is the authorizer's INJECT socket, reached by the group of the user envoy-inject alone. The host table admits
# INJECT_PORT only when INJECT_PORT_ELEMENT is ", <port>" (empty here, so a deployment without inject opens nothing).
INJECT_PORT=3133
INJECT_HOST=api.upstream.example.com
INJECT_UPSTREAM_PORT=443
INJECT_DOMAIN=api.upstream.example.com
INJECT_CA_FILE=/etc/ssl/certs/ca-certificates.crt
INJECT_STREAM_IDLE_SECS=300
INJECT_MAX_STREAM_SECS=3600
INJECT_AUTHORIZER_SOCKET=/run/mediatore-gateway/inject/inject.sock
INJECT_PORT_ELEMENT=
# mediatore gateway's own environment (ADR-0028 decision 4): the broker's sandbox
# listener, reached on the egress side with the gateway SVID; the same socket.
MEDIATORE_URL=https://192.0.2.21
SPIFFE_ENDPOINT_SOCKET=unix:///run/spire/sockets/agent.sock
RUST_LOG=info
