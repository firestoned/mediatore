#
# The sandbox interface (banlieue ADR-0109 decisions 4 and 6: the second NIC, its fixed
# address written by the image, never by banlieue). Rendered to
# /run/systemd/network/20-sandbox.network by mediatore-gateway-network.service from the
# per-VM env file. No gateway and no resolver on this side: the segment is layer 2 only,
# and the default route is the egress interface's.
[Match]
Name=@SANDBOX_IF@

[Network]
Address=@SANDBOX_ADDRESS@/@SANDBOX_PREFIX@
LinkLocalAddressing=no
LLDP=no
EmitLLDP=no
IPv6AcceptRA=no
