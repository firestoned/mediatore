[Unit]
Description=SPIRE agent (TPM node attestation)
After=network-online.target
Wants=network-online.target

[Service]
User=spire
SupplementaryGroups=tss
ExecStart=/opt/spire/bin/spire-agent run -config /opt/spire/conf/agent.conf
# The vTPM, for the tpm attestor plugin (ADR-0018): the resource manager device first,
# the raw device as go-attestation's fallback; nothing else under /dev.
DeviceAllow=/dev/tpmrm0 rw
DeviceAllow=/dev/tpm0 rw
DevicePolicy=closed
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/spire /run/spire

[Install]
WantedBy=multi-user.target
