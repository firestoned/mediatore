[Unit]
Description=mediatore in-guest agent (banlieue sandbox)
After=spire-agent.service network-online.target mediatore-host-nft.service
Requires=spire-agent.service mediatore-host-nft.service
Wants=network-online.target
# Only the system booted from the installed disk (banlieue ADR-0043 decision 2, ADR-0019
# decision 4): Kairos runs the same enabled units in the live installer and in recovery,
# and an installer that attests, registers and announces mid-install is handed out
# mid-install. A non-Kairos image drops these two lines or provides the sentinel.
ConditionPathExists=|/run/cos/active_mode
ConditionPathExists=|/run/cos/passive_mode

[Service]
Type=simple
User=root
ExecStartPre=/usr/bin/spire-agent healthcheck -socketPath /run/spire/sockets/agent.sock
ExecStart=/usr/bin/mediatore guest
EnvironmentFile=-/etc/mediatore-guest/env
Restart=on-failure
RestartSec=5
# The whole cgroup ends with the guest, not the main process alone: a workload that
# outlived nsjail (it can clear its parent-death signal) does not outlive the unit.
KillMode=control-group
# Ten seconds for the guest's own teardown after SIGTERM, no more.
TimeoutStopSec=10
# Then SIGKILL to whatever is left in the cgroup.
SendSIGKILL=yes
RuntimeDirectory=mediatore-guest
# A line on stdout or stderr that starts with <N> is text, never a journal priority.
SyslogLevelPrefix=no
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
