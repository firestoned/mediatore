#
# The pool VM's host table (ADR-0029 decision 3; ADR-0010's outline, ADR-0020 decision 3,
# ADR-0027 decision 6): the bound on every uid, root's included, in an environment with
# egress gateways. Input is default drop (loopback and established only: a pool VM
# listens for nobody). Output is default drop but for loopback, established traffic and
# TCP to the addresses the pool's own files name: the gateways' data port
# (/etc/mediatore/gateways), the control relay's broker and SPIRE ports (MEDIATORE_URL in
# the guest's env, server_address and server_port in the agent's configuration, and the bundle leg's
# SPIRE_BUNDLE_GATEWAY and SPIRE_BUNDLE_PORT when the pool fetches its bundle, ADR-0037) and
# each gateway at MEDIATORE_INJECT_PORT when the pool has a gateway-placed audience
# (ADR-0040). No registry address, for any uid: an image is pulled through the claim's
# egress proxy and a gateway (ADR-0063 decision 4), so a registries file that names one, or
# MEDIATORE_RELAY_REGISTRIES (ADR-0038's leg, removed), is refused. Forward is dropped. Every entry
# must be an IPv4 address and a port: the segment has no resolver, and a name here would be
# a rule that admits nothing while looking like one. Loaded in one transaction by
# mediatore-host-nft.service before the agent and the guest start; the sandbox uid's
# per-claim table (mediatore_sandbox) sits beside it as the second layer.
#
#   host-table [--render] [gateways-file] [registries-file] [guest-env] [agent-conf]
#
# --render prints the table instead of loading it. The files default to the paths above;
# the registries file must be absent or empty (ADR-0063), the other three must exist.
#
# On Azure (ADR-0068), read from the DMI chassis asset tag Azure sets on every VM, the output
# chain also drops the instance metadata service (169.254.169.254) for every uid, by an
# explicit rule ahead of any accept, and admits the platform's WireServer (168.63.129.16) to
# root alone at TCP 80 and 32526 (the provisioning ready report and the host plugin), and to
# systemd-networkd's own user for the DHCP renewal (UDP 68 to 67). No sandbox uid and no other
# daemon reaches either address; anywhere else the table is unchanged. On every platform a
# link-local address or WireServer in the pool's files is refused: the every-uid set never
# names them. CHASSIS_ASSET_TAG_FILE overrides the sysfs path for tests.
#
# What the table drops and no honest machine sends is counted by name (ADR-0070 decision 4), for
# the guest's segment reader to read and zero ("nft reset") and report to the broker:
#   pool_inbound  a new IPv4 TCP connection arriving at the VM, its source address and
#                 destination port kept in inbound_sources (a counter per element, five minutes)
#   pool_output   a new TCP connection leaving the VM that the table does not admit, whatever
#                 the uid, its destination port kept in output_ports
# Each is one rule that drops, placed directly in front of its chain's last drop, which would
# have dropped the same packet: no verdict changes, and nothing is accepted that was not. The
# counter comes before the set update, so a full set still counts and the next rule still
# drops. Anything that is not TCP stays with the chain's last rule, uncounted by name.
set -eu

render=0
if [ "${1:-}" = --render ]; then render=1; shift; fi
gateways=${1:-/etc/mediatore/gateways}
registries=${2:-/etc/mediatore/registries}
guest_env=${3:-/etc/mediatore-guest/env}
agent_conf=${4:-/etc/spire/agent.conf}

die() { echo "host-table: $*" >&2; exit 1; }

# Azure's platform addresses (ADR-0068) and the asset tag that says the VM is on Azure.
AZURE_ASSET_TAG='7783-7084-3265-9085-8269-3286-77'
WIRESERVER='168.63.129.16'
IMDS='169.254.169.254'
tag_file=${CHASSIS_ASSET_TAG_FILE:-/sys/class/dmi/id/chassis_asset_tag}
azure=0
if [ -r "$tag_file" ] && [ "$(tr -d '[:space:]' < "$tag_file")" = "$AZURE_ASSET_TAG" ]; then azure=1; fi

# An IPv4 address and a port, as `nft` elements want them.
is_addr_port() {
  printf '%s' "$1" | grep -Eq '^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]):([1-9][0-9]{0,4})$'
}

elements=''
add() { # <what> <address:port>
  is_addr_port "$2" || die "$1: $2 is not an IPv4 address and a port (the segment has no resolver; names are refused, ADR-0029)"
  case ${2%:*} in
    169.254.*|"$WIRESERVER") die "$1: ${2%:*} is a link-local or platform address (IMDS, WireServer): never in the every-uid set (ADR-0068)" ;;
  esac
  el="${2%:*} . ${2##*:}"
  case " $elements " in *" $el,"*|*" $el "*) return ;; esac
  elements="${elements:+$elements, }$el"
}

[ -f "$gateways" ] || die "$gateways: no gateway list; without gateways the pool loads no host table (ADR-0029 decision 4)"
n=0
while IFS= read -r line || [ -n "$line" ]; do
  line=$(printf '%s' "$line" | sed 's/[[:space:]]*$//; s/^[[:space:]]*//')
  case $line in ''|'#'*) continue ;; esac
  add "$gateways" "$line"; n=$((n+1))
done < "$gateways"
[ "$n" -gt 0 ] || die "$gateways names no gateway"

# ADR-0063 decision 4: no registry is reached but through a claim's egress proxy and a gateway, so a registry on
# the segment (this file) is refused, loudly, never silently dropped.
if [ -f "$registries" ] && grep -Eqv '^[[:space:]]*(#.*)?$' "$registries"; then
  die "$registries names a registry: with gateways the pull goes through the claim's egress proxy and a gateway, never to the segment; remove the file (ADR-0063 decision 4)"
fi

[ -f "$guest_env" ] || die "$guest_env: no guest environment (MEDIATORE_URL names the control relay's broker port)"
url=$(sed -n 's/^MEDIATORE_URL=//p' "$guest_env" | tail -1)
[ -n "$url" ] || die "$guest_env: no MEDIATORE_URL"
hostport=${url#*://}; hostport=${hostport%%/*}
case $hostport in *:*) ;; *) case $url in https://*) hostport="$hostport:443" ;; http://*) hostport="$hostport:80" ;; *) die "MEDIATORE_URL $url: unknown scheme" ;; esac ;; esac
add "MEDIATORE_URL" "$hostport"

[ -f "$agent_conf" ] || die "$agent_conf: no agent configuration (server_address and server_port name the control relay's SPIRE port)"
sa=$(sed -n 's/^[[:space:]]*server_address[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$agent_conf" | head -1)
sp=$(sed -n 's/^[[:space:]]*server_port[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$agent_conf" | head -1)
[ -n "$sa" ] && [ -n "$sp" ] || die "$agent_conf: server_address and server_port are required"
add "agent.conf server_address" "$sa:$sp"

# The bundle leg (ADR-0037): a pool that fetches its SPIRE bundle at boot names the gateway and the
# relay's bundle port in the guest's env; one that carries the bundle as a file names neither.
bg=$(sed -n 's/^SPIRE_BUNDLE_GATEWAY=//p' "$guest_env" | tail -1)
if [ -n "$bg" ]; then
  bp=$(sed -n 's/^SPIRE_BUNDLE_PORT=//p' "$guest_env" | tail -1)
  [ -n "$bp" ] || die "$guest_env: SPIRE_BUNDLE_GATEWAY is set without SPIRE_BUNDLE_PORT"
  add "SPIRE_BUNDLE_GATEWAY" "$bg:$bp"
fi

# The gateways' inject port (ADR-0040): a claim with a gateway-placed audience has its egress proxy dial each
# gateway at this port, as the sandbox uid, to send the request the gateway adds the credential to. Every uid like
# the data port; the sandbox uid's own per-claim table (mediatore_sandbox) is the second layer and lists the port
# only for a claim that needs it. Unset on a pool with no gateway-placed audience: nothing is admitted.
inject_port=$(sed -n 's/^MEDIATORE_INJECT_PORT=//p' "$guest_env" | tail -1)
if [ -n "$inject_port" ]; then
  printf '%s' "$inject_port" | grep -Eq '^[1-9][0-9]{0,4}$' && [ "$inject_port" -le 65535 ] || die "$guest_env: MEDIATORE_INJECT_PORT '$inject_port' is not a port"
  while IFS= read -r line || [ -n "$line" ]; do
    line=$(printf '%s' "$line" | sed 's/[[:space:]]*$//; s/^[[:space:]]*//')
    case $line in ''|'#'*) continue ;; esac
    add "MEDIATORE_INJECT_PORT" "$(printf '%s' "$line" | sed 's/:[^:]*$//'):$inject_port"
  done < "$gateways"
fi

# The registry legs of ADR-0038 are gone (ADR-0063 decision 4): an env file that still names one is refused.
if grep -q '^MEDIATORE_RELAY_REGISTRIES=.' "$guest_env"; then
  die "$guest_env sets MEDIATORE_RELAY_REGISTRIES: the relay has no registry leg; the pull goes through the claim's egress proxy and a gateway (ADR-0063 decision 4)"
fi

# ADR-0068: the lines only an Azure render carries; empty anywhere else, so that table is unchanged.
az_comment='' az_imds='' az_wireserver=''
if [ "$azure" = 1 ]; then
  az_comment="
# on Azure (ADR-0068): IMDS dropped for every uid; WireServer for root alone, at 80 and 32526, and the DHCP renewal of systemd-networkd"
  az_imds="
    ip daddr $IMDS log prefix \"mediatore-host imds: \" counter drop"
  az_wireserver="
    ip daddr $WIRESERVER tcp dport { 80, 32526 } meta skuid 0 accept
    ip daddr $WIRESERVER udp sport 68 udp dport 67 meta skuid \"systemd-network\" accept"
fi

table=$(cat <<NFT
# mediatore host table (ADR-0029, ADR-0063): every uid reaches the gateways' two planes and nothing else; nothing comes in$az_comment
table inet mediatore_host
delete table inet mediatore_host
table inet mediatore_host {
  set allow4 { type ipv4_addr . inet_service; elements = { $elements } }
  set inbound_sources { type ipv4_addr . inet_service; size 4096; flags dynamic,timeout; counter; timeout 5m; }
  set output_ports { type inet_service; size 1024; flags dynamic,timeout; counter; timeout 5m; }
  counter pool_inbound { }
  counter pool_output { }
  chain input {
    type filter hook input priority filter; policy drop;
    iif "lo" accept
    ct state established,related accept
    ct state invalid drop
    meta nfproto ipv4 meta l4proto tcp ct state new counter name "pool_inbound" update @inbound_sources { ip saddr . tcp dport } log prefix "mediatore-host input: " drop
    log prefix "mediatore-host input: " counter drop
  }
  chain forward {
    type filter hook forward priority filter; policy drop;
    log prefix "mediatore-host forward: " counter drop
  }
  chain output {
    type filter hook output priority filter; policy drop;
    oif "lo" accept$az_imds
    ct state established,related accept
    ip daddr . tcp dport @allow4 accept$az_wireserver
    meta l4proto tcp ct state new counter name "pool_output" update @output_ports { tcp dport } log prefix "mediatore-host drop: " drop
    log prefix "mediatore-host drop: " counter drop
  }
}
NFT
)
if [ "$render" = 1 ]; then
  printf '%s\n' "$table"
else
  printf '%s\n' "$table" | nft -f -
  echo "host-table: loaded inet mediatore_host with $(printf '%s' "$elements" | tr ',' '\n' | wc -l | tr -d ' ') destinations$([ "$azure" = 1 ] && echo '; on Azure: IMDS dropped, WireServer for root and the DHCP renewal (ADR-0068)')"
fi
